<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-nis2-measures" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">NIS2 Cybersecurity Risk-Management Measures (starter)</name>
  <documentation xml:lang="en">The ten cybersecurity risk-management measures of Article 21(2) of the NIS2 Directive (EU) 2022/2555, the governance duty of Article 20 and the incident reporting stages of Article 23, each traced to the control that realizes it. Replace the example controls with your own processes and systems; a requirement left without a realizing control is a gap. This model is a structuring aid, not legal advice: confirm scope and national transposition with your compliance team.</documentation>
  <elements>
    <element identifier="id-driver-nis2-directive-eu-2022-2555" xsi:type="Driver">
      <name xml:lang="en">NIS2 Directive (EU) 2022/2555</name>
      <documentation xml:lang="en">Applies to essential and important entities in the sectors of Annexes I and II, as transposed into national law by member states from 18 October 2024.</documentation>
    </element>
    <element identifier="id-stakeholder-management-body" xsi:type="Stakeholder">
      <name xml:lang="en">Management body</name>
      <documentation xml:lang="en">Approves the cybersecurity risk-management measures, oversees their implementation and can be held liable for infringements (Article 20).</documentation>
    </element>
    <element identifier="id-goal-appropriate-and-proportionate-cybersecurity-risk-management" xsi:type="Goal">
      <name xml:lang="en">Appropriate and proportionate cybersecurity risk management</name>
      <documentation xml:lang="en">Article 21(1): technical, operational and organisational measures to manage the risks to the security of network and information systems, and to prevent or minimise the impact of incidents.</documentation>
    </element>
    <element identifier="id-requirement-article-21-2-measures" xsi:type="Requirement">
      <name xml:lang="en">Article 21(2) measures</name>
      <documentation xml:lang="en">The minimum set of measures, based on an all-hazards approach.</documentation>
    </element>
    <element identifier="id-requirement-21-2-a-risk-analysis-and-information-system-security-policies" xsi:type="Requirement">
      <name xml:lang="en">21(2)(a) Risk analysis and information system security policies</name>
      <documentation xml:lang="en">Policies on risk analysis and information system security.</documentation>
    </element>
    <element identifier="id-businessprocess-information-security-risk-assessment" xsi:type="BusinessProcess">
