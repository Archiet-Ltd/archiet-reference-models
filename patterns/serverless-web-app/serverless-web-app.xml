<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-serverless-web-app" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Serverless Web Application</name>
  <documentation xml:lang="en">A web application with no servers to manage: static front end on a content delivery network, an HTTP API backed by functions, and managed data stores. You pay for requests, not idle capacity.</documentation>
  <elements>
    <element identifier="id-businessactor-users" xsi:type="BusinessActor">
      <name xml:lang="en">Users</name>
    </element>
    <element identifier="id-technologyservice-content-delivery-network" xsi:type="TechnologyService">
      <name xml:lang="en">Content delivery network</name>
    </element>
    <element identifier="id-artifact-web-app-bundle" xsi:type="Artifact">
      <name xml:lang="en">Web app bundle</name>
      <documentation xml:lang="en">Static HTML, JavaScript and assets.</documentation>
    </element>
    <element identifier="id-applicationcomponent-http-api" xsi:type="ApplicationComponent">
      <name xml:lang="en">HTTP API</name>
      <documentation xml:lang="en">Managed API endpoint that authenticates requests and invokes functions.</documentation>
    </element>
    <element identifier="id-applicationcomponent-order-functions" xsi:type="ApplicationComponent">
      <name xml:lang="en">Order functions</name>
      <documentation xml:lang="en">One small function per operation.</documentation>
    </element>
    <element identifier="id-applicationcomponent-image-processing-function" xsi:type="ApplicationComponent">
      <name xml:lang="en">Image processing function</name>
      <documentation xml:lang="en">Runs when a file lands in object storage, not when a user waits.</documentation>
    </element>
    <element identifier="id-technologyservice-function-runtime" xsi:type="TechnologyService">
      <name xml:lang="en">Function runtime</name>
    </element>
    <element identifier="id-dataobject-orders-table" xsi:type="DataObject">
      <name xml:lang="en">Orders table</name>
      <documentation xml:lang="en">Managed key-value store, designed around access patterns.</documentation>
    </element>
    <element identifier="id-dataobject-uploaded-images" xsi:type="DataObject">
      <name xml:lang="en">Uploaded images</name>
      <documentation xml:lang="en">Object storage.</documentation>
    </element>
  </elements>
  <relationships>
    <relationship identifier="id-rel-001" source="id-technologyservice-content-delivery-network" target="id-businessactor-users" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-002" source="id-technologyservice-content-delivery-network" target="id-artifact-web-app-bundle" xsi:type="Access" accessType="Read">
    </relationship>
    <relationship identifier="id-rel-003" source="id-applicationcomponent-http-api" target="id-businessactor-users" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-004" source="id-applicationcomponent-order-functions" target="id-applicationcomponent-http-api" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-005" source="id-technologyservice-function-runtime" target="id-applicationcomponent-order-functions" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-006" source="id-technologyservice-function-runtime" target="id-applicationcomponent-image-processing-function" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-007" source="id-applicationcomponent-order-functions" target="id-dataobject-orders-table" xsi:type="Access">
    </relationship>
    <relationship identifier="id-rel-008" source="id-applicationcomponent-image-processing-function" target="id-dataobject-uploaded-images" xsi:type="Access">
    </relationship>
  </relationships>
  <organizations>
