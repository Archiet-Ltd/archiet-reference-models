<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-zero-trust-access" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Zero-Trust Access</name>
  <documentation xml:lang="en">No request is trusted because of where it comes from. Every request to an internal application passes an access proxy, which asks a policy engine to decide using the user's identity, the health of their device and the sensitivity of the application, every time.</documentation>
  <elements>
    <element identifier="id-businessactor-employee-or-contractor" xsi:type="BusinessActor">
      <name xml:lang="en">Employee or contractor</name>
    </element>
    <element identifier="id-device-managed-device" xsi:type="Device">
      <name xml:lang="en">Managed device</name>
    </element>
    <element identifier="id-applicationcomponent-access-proxy" xsi:type="ApplicationComponent">
      <name xml:lang="en">Access proxy</name>
      <documentation xml:lang="en">Policy enforcement point: the only route to internal applications.</documentation>
    </element>
    <element identifier="id-applicationcomponent-internal-applications" xsi:type="ApplicationComponent">
      <name xml:lang="en">Internal applications</name>
      <documentation xml:lang="en">Not reachable from the network directly.</documentation>
    </element>
    <element identifier="id-applicationcomponent-policy-engine" xsi:type="ApplicationComponent">
      <name xml:lang="en">Policy engine</name>
      <documentation xml:lang="en">Policy decision point: allows, denies or asks for step-up authentication, per request.</documentation>
    </element>
    <element identifier="id-applicationcomponent-identity-provider" xsi:type="ApplicationComponent">
      <name xml:lang="en">Identity provider</name>
      <documentation xml:lang="en">Strong, phishing-resistant multi-factor authentication.</documentation>
    </element>
    <element identifier="id-applicationcomponent-device-posture-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Device posture service</name>
      <documentation xml:lang="en">Is the device managed, patched and encrypted right now?</documentation>
    </element>
    <element identifier="id-applicationcomponent-security-monitoring" xsi:type="ApplicationComponent">
      <name xml:lang="en">Security monitoring</name>
      <documentation xml:lang="en">Every decision is logged and analysed.</documentation>
    </element>
    <element identifier="id-grouping-principles" xsi:type="Grouping">
      <name xml:lang="en">Principles</name>
    </element>
    <element identifier="id-principle-never-trust-the-network" xsi:type="Principle">
      <name xml:lang="en">Never trust the network</name>
    </element>
    <element identifier="id-principle-verify-every-request" xsi:type="Principle">
      <name xml:lang="en">Verify every request</name>
    </element>
    <element identifier="id-principle-least-privilege-granted-just-in-time" xsi:type="Principle">
      <name xml:lang="en">Least privilege, granted just in time</name>
    </element>
  </elements>
