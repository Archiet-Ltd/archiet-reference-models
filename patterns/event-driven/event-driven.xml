<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-event-driven" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Event-Driven Architecture</name>
  <documentation xml:lang="en">Services announce what happened as events and other services react, instead of calling each other directly. The producer writes the event to an outbox in the same transaction as its own data, so an event is never lost and never published for a change that did not happen.</documentation>
  <elements>
    <element identifier="id-applicationcomponent-order-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Order service</name>
    </element>
    <element identifier="id-applicationprocess-place-order" xsi:type="ApplicationProcess">
      <name xml:lang="en">Place order</name>
    </element>
    <element identifier="id-dataobject-outbox" xsi:type="DataObject">
      <name xml:lang="en">Outbox</name>
      <documentation xml:lang="en">Written in the same database transaction as the order; a relay publishes from it to the event stream.</documentation>
    </element>
    <element identifier="id-applicationevent-order-placed" xsi:type="ApplicationEvent">
      <name xml:lang="en">Order placed</name>
    </element>
    <element identifier="id-dataobject-order-placed-event-versioned-schema" xsi:type="DataObject">
      <name xml:lang="en">Order placed event (versioned schema)</name>
      <documentation xml:lang="en">Consumers depend on the schema, not on the producer. Additive changes only; breaking changes get a new version.</documentation>
    </element>
    <element identifier="id-applicationcomponent-inventory-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Inventory service</name>
    </element>
    <element identifier="id-applicationprocess-reserve-stock" xsi:type="ApplicationProcess">
      <name xml:lang="en">Reserve stock</name>
      <documentation xml:lang="en">Idempotent: processing the same event twice has no further effect, because delivery is at least once.</documentation>
    </element>
    <element identifier="id-applicationcomponent-notification-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Notification service</name>
    </element>
    <element identifier="id-applicationprocess-send-confirmation" xsi:type="ApplicationProcess">
      <name xml:lang="en">Send confirmation</name>
      <documentation xml:lang="en">Idempotent: processing the same event twice has no further effect, because delivery is at least once.</documentation>
    </element>
    <element identifier="id-applicationcomponent-analytics-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Analytics service</name>
    </element>
    <element identifier="id-applicationprocess-update-sales-figures" xsi:type="ApplicationProcess">
      <name xml:lang="en">Update sales figures</name>
      <documentation xml:lang="en">Idempotent: processing the same event twice has no further effect, because delivery is at least once.</documentation>
    </element>
    <element identifier="id-technologyservice-event-streaming" xsi:type="TechnologyService">
      <name xml:lang="en">Event streaming</name>
      <documentation xml:lang="en">Durable, ordered, replayable event log.</documentation>
    </element>
    <element identifier="id-node-broker-cluster" xsi:type="Node">
      <name xml:lang="en">Broker cluster</name>
    </element>
    <element identifier="id-artifact-dead-letter-queue" xsi:type="Artifact">
      <name xml:lang="en">Dead-letter queue</name>
      <documentation xml:lang="en">Events a consumer could not process, kept for inspection and replay instead of blocking the stream.</documentation>
    </element>
  </elements>
