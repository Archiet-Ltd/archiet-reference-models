    </relationship>
    <relationship identifier="id-rel-005" source="id-node-standby-database" target="id-node-application-cluster-b" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-006" source="id-node-primary-database" target="id-node-standby-database" xsi:type="Flow">
      <name xml:lang="en">replication</name>
    </relationship>
    <relationship identifier="id-rel-007" source="id-technologyservice-global-traffic-routing" target="id-requirement-recovery-time-objective-15-minutes" xsi:type="Realization">
    </relationship>
    <relationship identifier="id-rel-008" source="id-node-standby-database" target="id-requirement-recovery-point-objective-under-1-minute-of-data" xsi:type="Realization">
    </relationship>
    <relationship identifier="id-rel-009" source="id-location-region-a-primary" target="id-node-application-cluster-a" xsi:type="Aggregation">
    </relationship>
    <relationship identifier="id-rel-010" source="id-location-region-a-primary" target="id-node-primary-database" xsi:type="Aggregation">
    </relationship>
    <relationship identifier="id-rel-011" source="id-location-region-b-standby" target="id-node-application-cluster-b" xsi:type="Aggregation">
    </relationship>
    <relationship identifier="id-rel-012" source="id-location-region-b-standby" target="id-node-standby-database" xsi:type="Aggregation">
    </relationship>
  </relationships>
