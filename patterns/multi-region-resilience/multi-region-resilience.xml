<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-multi-region-resilience" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Multi-Region Resilience (active-passive)</name>
  <documentation xml:lang="en">The application runs in a primary region with a warm standby in a second region. The database replicates continuously; if the primary region fails, traffic routing moves users to the standby. Recovery time and recovery point are stated as requirements and tested.</documentation>
  <elements>
    <element identifier="id-businessactor-users" xsi:type="BusinessActor">
      <name xml:lang="en">Users</name>
    </element>
    <element identifier="id-technologyservice-global-traffic-routing" xsi:type="TechnologyService">
      <name xml:lang="en">Global traffic routing</name>
      <documentation xml:lang="en">Health-checked DNS or anycast that sends users to the healthy region.</documentation>
    </element>
    <element identifier="id-location-region-a-primary" xsi:type="Location">
      <name xml:lang="en">Region A (primary)</name>
    </element>
    <element identifier="id-location-region-b-standby" xsi:type="Location">
      <name xml:lang="en">Region B (standby)</name>
    </element>
    <element identifier="id-node-application-cluster-a" xsi:type="Node">
      <name xml:lang="en">Application cluster A</name>
    </element>
    <element identifier="id-node-primary-database" xsi:type="Node">
      <name xml:lang="en">Primary database</name>
    </element>
    <element identifier="id-node-application-cluster-b" xsi:type="Node">
      <name xml:lang="en">Application cluster B</name>
      <documentation xml:lang="en">Running at reduced size; scales up on failover.</documentation>
    </element>
    <element identifier="id-node-standby-database" xsi:type="Node">
      <name xml:lang="en">Standby database</name>
      <documentation xml:lang="en">Continuously replicated replica, promoted on failover.</documentation>
    </element>
    <element identifier="id-requirement-recovery-time-objective-15-minutes" xsi:type="Requirement">
      <name xml:lang="en">Recovery time objective: 15 minutes</name>
    </element>
    <element identifier="id-requirement-recovery-point-objective-under-1-minute-of-data" xsi:type="Requirement">
      <name xml:lang="en">Recovery point objective: under 1 minute of data</name>
    </element>
  </elements>
  <relationships>
    <relationship identifier="id-rel-001" source="id-technologyservice-global-traffic-routing" target="id-businessactor-users" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-002" source="id-technologyservice-global-traffic-routing" target="id-node-application-cluster-a" xsi:type="Serving">
    </relationship>
    <relationship identifier="id-rel-003" source="id-technologyservice-global-traffic-routing" target="id-node-application-cluster-b" xsi:type="Serving">
