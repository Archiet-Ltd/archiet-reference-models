<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-multi-tenant-saas" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Multi-Tenant SaaS</name>
  <documentation xml:lang="en">One application serving many customer organisations (tenants) from shared infrastructure, with tenant isolation enforced in the data layer. Standard tenants share a pooled database protected by row-level security; premium or regulated tenants get a dedicated database. The tenant catalog records where every tenant lives, so the same code serves both.</documentation>
  <elements>
    <element identifier="id-businessactor-tenant-users" xsi:type="BusinessActor">
      <name xml:lang="en">Tenant users</name>
      <documentation xml:lang="en">People from many customer organisations using one product.</documentation>
    </element>
    <element identifier="id-applicationcomponent-identity-and-tenant-resolution" xsi:type="ApplicationComponent">
      <name xml:lang="en">Identity and tenant resolution</name>
      <documentation xml:lang="en">Signs users in and stamps every token with the tenant it belongs to. Nothing downstream trusts a tenant id from the request body.</documentation>
    </element>
    <element identifier="id-applicationcomponent-api-gateway" xsi:type="ApplicationComponent">
      <name xml:lang="en">API gateway</name>
      <documentation xml:lang="en">Single entry point. Validates the token, applies per-tenant rate limits so one noisy tenant cannot starve the rest, and passes tenant context on.</documentation>
    </element>
    <element identifier="id-applicationcomponent-tenant-administration-and-billing" xsi:type="ApplicationComponent">
      <name xml:lang="en">Tenant administration and billing</name>
      <documentation xml:lang="en">Sign-up, plans, seats and usage metering per tenant.</documentation>
    </element>
    <element identifier="id-applicationcomponent-application-services" xsi:type="ApplicationComponent">
      <name xml:lang="en">Application services</name>
      <documentation xml:lang="en">Stateless business logic. Every call carries tenant context; no service holds tenant state.</documentation>
    </element>
    <element identifier="id-applicationcomponent-background-workers" xsi:type="ApplicationComponent">
      <name xml:lang="en">Background workers</name>
      <documentation xml:lang="en">Asynchronous jobs, queued per tenant so one tenant's backlog does not delay another's.</documentation>
    </element>
    <element identifier="id-applicationcomponent-tenant-aware-data-access" xsi:type="ApplicationComponent">
      <name xml:lang="en">Tenant-aware data access</name>
      <documentation xml:lang="en">The one place tenant isolation is enforced: sets the tenant on every connection and routes each tenant to its pooled or dedicated store using the tenant catalog.</documentation>
    </element>
    <element identifier="id-node-container-platform" xsi:type="Node">
      <name xml:lang="en">Container platform</name>
      <documentation xml:lang="en">Runs the stateless services and scales them horizontally.</documentation>
    </element>
    <element identifier="id-technologyservice-managed-relational-database" xsi:type="TechnologyService">
      <name xml:lang="en">Managed relational database</name>
    </element>
    <element identifier="id-technologyservice-message-queue" xsi:type="TechnologyService">
      <name xml:lang="en">Message queue</name>
    </element>
    <element identifier="id-grouping-standard-tenants-pooled" xsi:type="Grouping">
      <name xml:lang="en">Standard tenants: pooled</name>
    </element>
    <element identifier="id-grouping-premium-tenants-dedicated" xsi:type="Grouping">
      <name xml:lang="en">Premium tenants: dedicated</name>
    </element>
    <element identifier="id-dataobject-shared-database-with-row-level-security" xsi:type="DataObject">
      <name xml:lang="en">Shared database with row-level security</name>
      <documentation xml:lang="en">Every row carries a tenant id and the database itself refuses cross-tenant reads.</documentation>
    </element>
    <element identifier="id-dataobject-dedicated-tenant-database" xsi:type="DataObject">
      <name xml:lang="en">Dedicated tenant database</name>
      <documentation xml:lang="en">One database per tenant, for data residency, contractual isolation or very large tenants.</documentation>
    </element>
    <element identifier="id-dataobject-tenant-catalog" xsi:type="DataObject">
      <name xml:lang="en">Tenant catalog</name>
      <documentation xml:lang="en">Tenant, plan, region and which store holds its data.</documentation>
    </element>
  </elements>
