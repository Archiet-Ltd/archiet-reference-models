<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="id-data-platform" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd">
  <name xml:lang="en">Modern Data Platform</name>
  <documentation xml:lang="en">Operational data flows in from source systems, lands unchanged in a raw zone, is cleaned and modelled into a curated zone, and is served through one semantic layer so every report uses the same definitions. A catalog records where every dataset came from.</documentation>
  <elements>
    <element identifier="id-applicationcomponent-crm" xsi:type="ApplicationComponent">
      <name xml:lang="en">CRM</name>
    </element>
    <element identifier="id-applicationcomponent-erp" xsi:type="ApplicationComponent">
      <name xml:lang="en">ERP</name>
    </element>
    <element identifier="id-applicationcomponent-product-event-stream" xsi:type="ApplicationComponent">
      <name xml:lang="en">Product event stream</name>
    </element>
    <element identifier="id-applicationcomponent-ingestion-pipelines" xsi:type="ApplicationComponent">
      <name xml:lang="en">Ingestion pipelines</name>
      <documentation xml:lang="en">Copies source data in on a schedule or as a stream, without changing it.</documentation>
    </element>
    <element identifier="id-dataobject-raw-zone" xsi:type="DataObject">
      <name xml:lang="en">Raw zone</name>
      <documentation xml:lang="en">Source data exactly as received, kept so any result can be rebuilt.</documentation>
    </element>
    <element identifier="id-applicationcomponent-transformation-jobs" xsi:type="ApplicationComponent">
      <name xml:lang="en">Transformation jobs</name>
      <documentation xml:lang="en">Tested, version-controlled models that clean, join and conform the data.</documentation>
    </element>
    <element identifier="id-dataobject-curated-zone" xsi:type="DataObject">
      <name xml:lang="en">Curated zone</name>
      <documentation xml:lang="en">Conformed, documented tables that people may rely on.</documentation>
    </element>
    <element identifier="id-applicationcomponent-semantic-layer" xsi:type="ApplicationComponent">
      <name xml:lang="en">Semantic layer</name>
      <documentation xml:lang="en">One definition of revenue, customer and churn for every tool.</documentation>
    </element>
    <element identifier="id-applicationcomponent-dashboards-and-reports" xsi:type="ApplicationComponent">
      <name xml:lang="en">Dashboards and reports</name>
    </element>
    <element identifier="id-applicationcomponent-machine-learning" xsi:type="ApplicationComponent">
      <name xml:lang="en">Machine learning</name>
    </element>
    <element identifier="id-applicationcomponent-data-catalog-and-lineage" xsi:type="ApplicationComponent">
      <name xml:lang="en">Data catalog and lineage</name>
      <documentation xml:lang="en">Who owns each dataset, where it came from and what depends on it.</documentation>
    </element>
  </elements>
