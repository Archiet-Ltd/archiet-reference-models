  <name xml:lang="en">API Gateway and Microservices</name>
  <documentation xml:lang="en">A product split into independently deployable services, each owning its own data, behind one API gateway. Clients see a single API; teams ship their service without coordinating a release with everyone else.</documentation>
  <elements>
    <element identifier="id-businessactor-customers" xsi:type="BusinessActor">
      <name xml:lang="en">Customers</name>
    </element>
    <element identifier="id-applicationcomponent-web-front-end" xsi:type="ApplicationComponent">
      <name xml:lang="en">Web front end</name>
    </element>
    <element identifier="id-applicationcomponent-mobile-app" xsi:type="ApplicationComponent">
      <name xml:lang="en">Mobile app</name>
    </element>
    <element identifier="id-applicationcomponent-api-gateway" xsi:type="ApplicationComponent">
      <name xml:lang="en">API gateway</name>
      <documentation xml:lang="en">Routing, authentication, rate limiting and request shaping for each client. No business logic.</documentation>
    </element>
    <element identifier="id-applicationcomponent-identity-provider" xsi:type="ApplicationComponent">
      <name xml:lang="en">Identity provider</name>
    </element>
    <element identifier="id-applicationcomponent-catalogue-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Catalogue service</name>
    </element>
    <element identifier="id-dataobject-catalogue-database" xsi:type="DataObject">
      <name xml:lang="en">Catalogue database</name>
      <documentation xml:lang="en">Owned by one service. Other services ask that service; they never read its database.</documentation>
    </element>
    <element identifier="id-applicationcomponent-order-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Order service</name>
    </element>
    <element identifier="id-dataobject-order-database" xsi:type="DataObject">
      <name xml:lang="en">Order database</name>
      <documentation xml:lang="en">Owned by one service. Other services ask that service; they never read its database.</documentation>
    </element>
    <element identifier="id-applicationcomponent-payment-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Payment service</name>
    </element>
    <element identifier="id-dataobject-payment-ledger" xsi:type="DataObject">
      <name xml:lang="en">Payment ledger</name>
      <documentation xml:lang="en">Owned by one service. Other services ask that service; they never read its database.</documentation>
    </element>
    <element identifier="id-applicationcomponent-customer-account-service" xsi:type="ApplicationComponent">
      <name xml:lang="en">Customer account service</name>
    </element>
    <element identifier="id-dataobject-customer-database" xsi:type="DataObject">
      <name xml:lang="en">Customer database</name>
      <documentation xml:lang="en">Owned by one service. Other services ask that service; they never read its database.</documentation>
    </element>
  </elements>
